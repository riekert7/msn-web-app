# Copy to .env.dev and fill in your values for local development.
# .env.dev is gitignored — never commit real credentials.

FLASK_ENV=development
FLASK_DEBUG=1

# Override admin email to a test inbox so approval emails don't go to the real admin.
ADMIN_EMAIL=testbestwestyeet@gmail.com

# Use a separate dev Google Sheet to avoid polluting production data.
GOOGLE_SHEETS_ID=<your-dev-sheet-id>

# GCS bucket — same as prod is fine for dev (submissions are low-volume).
GCS_BUCKET_NAME=miyastudynotes-temp

# Google Drive folder IDs (same as prod unless you want separate dev folders).
EKN110_FOLDER_ID=<folder-id>
EKN120_FOLDER_ID=<folder-id>
EKN214_FOLDER_ID=<folder-id>

# SMTP — use your real SMTP config; student emails will go to their real address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<username>
SMTP_PASSWORD=<password>
FROM_EMAIL=noreply@miyastudynotes.co.za

APPROVAL_SECRET=<any-random-string-for-dev>
BASE_URL=http://localhost:5000
