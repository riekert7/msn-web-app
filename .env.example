# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# Flask auto-loads .env when you run `flask run` (requires python-dotenv in your venv).

FLASK_ENV=development
FLASK_DEBUG=1

# Dev overrides — change these from prod values
ADMIN_EMAIL=testbestwestyeet@gmail.com
GOOGLE_SHEETS_ID=<your-dev-sheet-id>
BASE_URL=http://localhost:5000

# Service account key for local Drive/Sheets access (never needed in Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=.keys/miya-study-notes-xxxx.json

# Same as prod
GCS_BUCKET_NAME=miya-study-notes-temp
EKN110_FOLDER_ID=<folder-id>
EKN120_FOLDER_ID=<folder-id>
EKN214_FOLDER_ID=<folder-id>
SMTP_HOST=smtp.miyastudynotes.co.za
SMTP_PORT=587
SMTP_USERNAME=<username>
SMTP_PASSWORD=<password>
FROM_EMAIL=info@miyastudynotes.co.za
APPROVAL_SECRET=<any-random-string-for-dev>
